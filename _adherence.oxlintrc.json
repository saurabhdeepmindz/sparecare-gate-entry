{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/annotation/**",
              "components/core/**",
              "components/wms/**",
              "ui_kits/wms-inward/**",
              "ui_kits/wms-inward/web/**",
              "web-portal/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Barlow Semi Condensed|Inter|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Barlow Semi Condensed, Inter, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActionBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<ActionBar> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnnotatedScreen'] > JSXAttribute > JSXIdentifier[name!=/^(?:screenLabel|screenRef|gutter|markers|children|key|ref|className|style|children)$/]",
        "message": "<AnnotatedScreen> doesn't accept that prop. Declared props: screenLabel, screenRef, gutter, markers, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnnotationItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:n|label|ref|control|description|tone|key|ref|className|style|children)$/]",
        "message": "<AnnotationItem> doesn't accept that prop. Declared props: n, label, ref, control, description, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnnotationItem'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|open)$/]",
        "message": "<AnnotationItem> tone must be one of 'primary' | 'open'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnnotationMarker'] > JSXAttribute > JSXIdentifier[name!=/^(?:n|x|y|size|tone|title|key|ref|className|style|children)$/]",
        "message": "<AnnotationMarker> doesn't accept that prop. Declared props: n, x, y, size, tone, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnnotationMarker'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|open)$/]",
        "message": "<AnnotationMarker> tone must be one of 'primary' | 'open'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrowserChrome'] > JSXAttribute > JSXIdentifier[name!=/^(?:url|accent|children|key|ref|className|style|children)$/]",
        "message": "<BrowserChrome> doesn't accept that prop. Declared props: url, accent, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|block|as|href|iconLeft|iconRight|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, block, as, href, iconLeft, iconRight, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|accent|secondary|ghost|onyx|quiet)$/]",
        "message": "<Button> variant must be one of 'primary' | 'accent' | 'secondary' | 'ghost' | 'onyx' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|md|sm)$/]",
        "message": "<Button> size must be one of 'lg' | 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CameraButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|size|key|ref|className|style|children)$/]",
        "message": "<CameraButton> doesn't accept that prop. Declared props: label, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|required|hint|adjacent|children|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, required, hint, adjacent, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='GenBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:gen|label|message|footnote|key|ref|className|style|children)$/]",
        "message": "<GenBanner> doesn't accept that prop. Declared props: gen, label, message, footnote."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContextItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|key|ref|className|style|children)$/]",
        "message": "<ContextItem> doesn't accept that prop. Declared props: label, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='HandheldFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|width|height|children|key|ref|className|style|children)$/]",
        "message": "<HandheldFrame> doesn't accept that prop. Declared props: label, width, height, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='InfoNote'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|children|key|ref|className|style|children)$/]",
        "message": "<InfoNote> doesn't accept that prop. Declared props: tone, icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='InfoNote'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:info|warn|error)$/]",
        "message": "<InfoNote> tone must be one of 'info' | 'warn' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='KpiTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|unit|active|key|ref|className|style|children)$/]",
        "message": "<KpiTile> doesn't accept that prop. Declared props: label, value, unit, active."
      },
      {
        "selector": "JSXOpeningElement[name.name='PartRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|fitment|partNumber|availability|tone|statusLabel|last|key|ref|className|style|children)$/]",
        "message": "<PartRow> doesn't accept that prop. Declared props: name, fitment, partNumber, availability, tone, statusLabel, last."
      },
      {
        "selector": "JSXOpeningElement[name.name='PartRow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ok|low|out)$/]",
        "message": "<PartRow> tone must be one of 'ok' | 'low' | 'out'."
      },
      {
        "selector": "JSXOpeningElement[name.name='QueueColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|align|mono|link|key|ref|className|style|children)$/]",
        "message": "<QueueColumn> doesn't accept that prop. Declared props: key, label, align, mono, link."
      },
      {
        "selector": "JSXOpeningElement[name.name='QueueColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right|center)$/]",
        "message": "<QueueColumn> align must be one of 'left' | 'right' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScreenHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|back|onBack|right|key|ref|className|style|children)$/]",
        "message": "<ScreenHeader> doesn't accept that prop. Declared props: title, back, onBack, right."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|value|onChange|glyph|maxWidth|key|ref|className|style|children)$/]",
        "message": "<SearchBar> doesn't accept that prop. Declared props: placeholder, value, onChange, glyph, maxWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|options|value|disabled|key|ref|className|style|children)$/]",
        "message": "<SelectInput> doesn't accept that prop. Declared props: placeholder, options, value, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stepper'] > JSXAttribute > JSXIdentifier[name!=/^(?:steps|current|onStepClick|key|ref|className|style|children)$/]",
        "message": "<Stepper> doesn't accept that prop. Declared props: steps, current, onStepClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='StoreCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|location|matchLabel|tone|key|ref|className|style|children)$/]",
        "message": "<StoreCard> doesn't accept that prop. Declared props: name, location, matchLabel, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='StoreCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ok|low|out|neutral)$/]",
        "message": "<StoreCard> tone must be one of 'ok' | 'low' | 'out' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|dot|children|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: tone, dot, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ok|low|out|neutral|info)$/]",
        "message": "<Tag> tone must be one of 'ok' | 'low' | 'out' | 'neutral' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:readOnly|mono|key|ref|className|style|children)$/]",
        "message": "<TextInput> doesn't accept that prop. Declared props: readOnly, mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='WireframeDoc'] > JSXAttribute > JSXIdentifier[name!=/^(?:mode|eyebrow|group|screenId|screenName|headline|intro|chips|sectionLabel|sectionNote|markers|items|legendColumns|gutter|children|key|ref|className|style|children)$/]",
        "message": "<WireframeDoc> doesn't accept that prop. Declared props: mode, eyebrow, group, screenId, screenName, headline, intro, chips, sectionLabel, sectionNote, markers, items, legendColumns, gutter, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='WireframeDoc'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:wireframe|annotated)$/]",
        "message": "<WireframeDoc> mode must be one of 'wireframe' | 'annotated'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SheetMeta'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|key|ref|className|style|children)$/]",
        "message": "<SheetMeta> doesn't accept that prop. Declared props: label, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='WorkflowStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|checked|locked|key|ref|className|style|children)$/]",
        "message": "<WorkflowStep> doesn't accept that prop. Declared props: id, label, checked, locked."
      }
    ]
  },
